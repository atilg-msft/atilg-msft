# Copy to .env and adjust. Paper trading needs no secrets at all.

# --- Runtime ---
POLYBOT_MODE=paper                 # paper | live
POLYBOT_DATA_DIR=data
POLYBOT_POLL_INTERVAL_SECONDS=60

# --- Market scanning ---
POLYBOT_MAX_MARKETS_SCANNED=200
POLYBOT_MIN_VOLUME_24H=1000
POLYBOT_MIN_LIQUIDITY=500
POLYBOT_MIN_PRICE=0.05
POLYBOT_MAX_PRICE=0.95

# --- Momentum strategy ---
POLYBOT_LOOKBACK_MINUTES=15
POLYBOT_MOMENTUM_THRESHOLD=0.08

# --- Exits ---
POLYBOT_TAKE_PROFIT_PCT=0.15
POLYBOT_STOP_LOSS_PCT=0.10
POLYBOT_MAX_HOLDING_MINUTES=240
POLYBOT_COOLDOWN_MINUTES=30

# --- Smart-money confirmation filter (opt-in; see README) ---
POLYBOT_SMART_WALLET_ENABLED=false
POLYBOT_SMART_WALLET_COUNT=30
POLYBOT_SMART_WALLET_PERIOD=month          # day | week | month (leaderboard window)
POLYBOT_SMART_WALLET_REFRESH_MINUTES=360
POLYBOT_SMART_WALLET_LOOKBACK_MINUTES=30
POLYBOT_SMART_WALLET_OVERRIDES=            # comma-separated wallet addresses to always track

# --- Risk / sizing ---
POLYBOT_MAX_CONCURRENT_POSITIONS=8
POLYBOT_MAX_POSITION_USD=50
POLYBOT_POSITION_PCT_OF_EQUITY=0.02
POLYBOT_MAX_TOTAL_EXPOSURE_PCT=0.6

# --- Paper trading ---
POLYBOT_STARTING_CASH=1000
POLYBOT_SLIPPAGE_BPS=50
POLYBOT_FEE_BPS=0

# --- Live trading only (POLYBOT_MODE=live) ---
# NEVER commit real values. Use a secrets manager or local .env excluded by git.
# POLYBOT_PRIVATE_KEY=0x...
# POLYBOT_SIGNATURE_TYPE=proxy       # proxy | eoa | gnosis-safe
# POLYBOT_FUNDER_ADDRESS=0x...       # proxy/safe wallet address, if applicable

# --- polybot-server only: Azure integration (all optional for local use) ---
# PORT=8000
# AZURE_KEY_VAULT_URL=https://<name>.vault.azure.net/
#   Loads POLYBOT_PRIVATE_KEY / POLYBOT_FUNDER_ADDRESS from secrets
#   "polybot-private-key" / "polybot-funder-address" via managed identity.
# AZURE_APPCONFIG_ENDPOINT=https://<name>.azconfig.io
#   Refreshes strategy/risk/scan POLYBOT_* values (not mode/secrets) via
#   managed identity, every AZURE_APPCONFIG_REFRESH_SECONDS.
# AZURE_APPCONFIG_LABEL=
# AZURE_APPCONFIG_REFRESH_SECONDS=300
