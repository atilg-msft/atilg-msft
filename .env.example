# Copy to .env and adjust. Paper trading needs no secrets at all.

# --- Runtime ---
POLYBOT_MODE=paper                 # paper | live
POLYBOT_DATA_DIR=data
POLYBOT_POLL_INTERVAL_SECONDS=60           # full market scan + new entries
POLYBOT_POSITION_CHECK_INTERVAL_SECONDS=5  # stop-loss/take-profit check for open positions

# --- Market scanning ---
POLYBOT_MAX_MARKETS_SCANNED=200
POLYBOT_MIN_VOLUME_24H=1000
POLYBOT_MIN_LIQUIDITY=500
POLYBOT_MIN_PRICE=0.15   # avoid extreme price zones (<0.15 or >0.85): thin-book/near-resolution tokens with far worse realized PnL
POLYBOT_MAX_PRICE=0.85

# --- Momentum strategy ---
POLYBOT_LOOKBACK_MINUTES=15
POLYBOT_MOMENTUM_THRESHOLD=0.08

# --- Exits ---
POLYBOT_TAKE_PROFIT_PCT=0.15
POLYBOT_STOP_LOSS_PCT=0.10
POLYBOT_MAX_HOLDING_MINUTES=240
POLYBOT_COOLDOWN_MINUTES=30

# --- Strategy + signal selection (also settable from the web control panel;
# a panel selection there takes precedence over these) ---
POLYBOT_STRATEGY=momentum                  # only "momentum" exists today
POLYBOT_SIGNAL_FILTER=none                 # none | smart_money

# --- Smart-money confirmation filter params (used when POLYBOT_SIGNAL_FILTER=smart_money; see README) ---
POLYBOT_SMART_WALLET_COUNT=30
POLYBOT_SMART_WALLET_PERIOD=month          # day | week | month (leaderboard window)
POLYBOT_SMART_WALLET_REFRESH_MINUTES=360
POLYBOT_SMART_WALLET_LOOKBACK_MINUTES=30
POLYBOT_SMART_WALLET_OVERRIDES=            # comma-separated wallet addresses to always track

# --- Risk / sizing ---
POLYBOT_MAX_CONCURRENT_POSITIONS=8
POLYBOT_MAX_POSITION_USD=50
POLYBOT_POSITION_PCT_OF_EQUITY=0.02
POLYBOT_MAX_TOTAL_EXPOSURE_PCT=0.6

# --- Paper trading ---
POLYBOT_STARTING_CASH=1000
POLYBOT_SLIPPAGE_BPS=50
POLYBOT_FEE_BPS=0

# --- Live trading only (POLYBOT_MODE=live) ---
# NEVER commit real values. Use a secrets manager or local .env excluded by git.
# POLYBOT_PRIVATE_KEY=0x...
# POLYBOT_SIGNATURE_TYPE=proxy       # proxy | eoa | gnosis-safe
# POLYBOT_FUNDER_ADDRESS=0x...       # proxy/safe wallet address, if applicable

# --- polybot-server only: Azure integration (all optional for local use) ---
# PORT=8000
# AZURE_KEY_VAULT_URL=https://<name>.vault.azure.net/
#   Periodically refreshes POLYBOT_PRIVATE_KEY / POLYBOT_FUNDER_ADDRESS /
#   POLYBOT_SIGNATURE_TYPE from secrets "polybot-private-key" /
#   "polybot-funder-address" / "polybot-signature-type" via managed
#   identity, every AZURE_KEY_VAULT_REFRESH_SECONDS -- rotating a wallet or
#   switching signature type doesn't need a redeploy.
# AZURE_KEY_VAULT_REFRESH_SECONDS=300
# AZURE_APPCONFIG_ENDPOINT=https://<name>.azconfig.io
#   Refreshes strategy/risk/scan POLYBOT_* values *and* POLYBOT_MODE via
#   managed identity, every AZURE_APPCONFIG_REFRESH_SECONDS -- flipping
#   paper<->live doesn't need a redeploy either, so App Configuration write
#   access is the real access-control boundary for going live.
# AZURE_APPCONFIG_LABEL=
# AZURE_APPCONFIG_REFRESH_SECONDS=300
